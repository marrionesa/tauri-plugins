{
  "name": "@marrionesa/plugin-mimetype",
  "version": "0.1.0",
  "description": "Map file extensions and paths to MIME types from Rust for Tauri apps.",
  "license": "MIT OR Apache-2.0",
  "authors": [
    "marrionesa <hola@marioramos.me>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marrionesa/tauri-plugins"
  },
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "rollup -c"
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE",
    "LICENSE_MIT",
    "LICENSE_APACHE-2.0"
  ],
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.18.0",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
